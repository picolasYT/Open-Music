<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:alertDialogTheme">@style/RoundedDialog</item><item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#040506</item>
        <item name="android:navigationBarColor">#040506</item><item name="android:windowBackground">#040506</item>
        <item name="android:colorAccent">#ff6363</item><item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="RoundedDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">#FF9D9D</item>
        <item name="android:buttonBarButtonStyle">@style/DialogAction</item>
        <item name="android:windowMinWidthMajor">94%</item>
        <item name="android:windowMinWidthMinor">94%</item>
    </style>
    <style name="DialogAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
    </style>
</resources>
